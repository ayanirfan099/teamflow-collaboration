{
  "name": "@teamflow/database",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma schema, generated client and migration tooling for TeamFlow",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate": "tsx scripts/generate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:deploy": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "db:local": "tsx src/local-postgres-cli.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "prisma": "6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
