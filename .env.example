# TeamFlow environment configuration.
#
# Copy this file to `.env` and adjust the values. Never commit a filled-in `.env`: the file is
# ignored by git and every secret has to come from a secret store in production.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The connection string of the Postgres database. The `schema` parameter selects the schema
# the API works in.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/teamflow?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=teamflow
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# 32 random bytes, hex encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start in production without this value.
SESSION_SECRET=change-me-to-32-random-bytes-hex

# Lifetime of a session in days.
SESSION_TTL_DAYS=30

# Comma separated list of origins that may send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# The session cookie. `secure` has to be true when the app is served over HTTPS.
SESSION_COOKIE_NAME=tf_session
CSRF_COOKIE_NAME=tf_csrf
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Optional: a shared parent domain, needed when the API runs on a sibling subdomain and the
# browser has to send the session cookie with the WebSocket handshake.
# COOKIE_DOMAIN=.example.com

# ---------------------------------------------------------------------------
# Web application
# ---------------------------------------------------------------------------
# The API URL used by the server side rewrite proxy. It never reaches the browser.
API_URL=http://localhost:4000
# The public API URL used by the browser for the WebSocket handshake.
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------
# `local` writes the files into STORAGE_DIR, `s3` uses the S3 adapter.
STORAGE_DRIVER=local
STORAGE_DIR=var/uploads
MAX_UPLOAD_BYTES=10485760

# Only used with STORAGE_DRIVER=s3.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=teamflow-attachments
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
